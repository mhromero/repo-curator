# Python bytecode and tooling caches
__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.tox/
/.nox/

# Local virtual environments
/.venv/
/venv/
/env/
/ENV/

# Local secrets and machine-specific files
/.env
/.env.*
!/.env.example
.DS_Store

# Real-repository evaluation records remain local until they have been reviewed
# for publication separately. Keep the anonymous public case template and the
# empty results directory tracked.
/evaluations/cases/*.json
!/evaluations/cases/example-student-coursework.json
/evaluations/results/*.json

# Python build and coverage output
/build/
/dist/
*.egg-info/
.coverage
.coverage.*
/htmlcov/
